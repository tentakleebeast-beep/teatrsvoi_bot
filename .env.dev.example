# Среда разработки (dev-контур): `.env.dev`.
#
#   cp .env.dev.example .env.dev
#   chmod 600 .env.dev
#   nano .env.dev          # вписать DEV_BOT_TOKEN отдельного бота «СВОИ dev»
#
# Это единственный файл окружения, который читают локальные запуски
# (`scripts/run_service.py`, агенты launchd, `scripts/start_services.py`) и локальные
# прогоны. Основной `.env` принадлежит боевому контуру: в dev-режиме он не
# открывается вовсе, поэтому локальный поллер физически не может взять прод-токен
# и перехватить getUpdates (инцидент 30.10.2026, docs/infrastructure/08 §1a).
#
# `.env.dev` в git не попадает (.gitignore); значения секретов — только локально.

# --- контур ---
ENV=dev
TZ_OFFSET_HOURS=4                # Самара, UTC+4

# --- Telegram ---
# Токен dev-бота из BotFather (@BotFather → /newbot → «СВОИ dev»).
# Пусто — локальный запуск отказывается с текстом «среда разработки не настроена».
DEV_BOT_TOKEN=
# Прод-токен здесь не нужен и не читается: гейтвей получает TELEGRAM_TOKEN
# из DEV_BOT_TOKEN на время dev-запуска.
ADMIN_CHAT_ID=

# --- БД: только локальная (127.0.0.1:5433) ---
# Любой другой хост dev-запуск отвергает: боевые данные вне dev-контура.
DATABASE_URL=postgresql://svoi:***@127.0.0.1:5433/svoi
POSTGRES_PASSWORD=svoi_dev_password

# --- сервис ---
TOOL_API_URL=http://127.0.0.1:8000
TOOL_API_TOKEN=dev-token
WEBAPP_SECRET=dev-secret

# --- Google ---
# Боевых файлов театра в dev-окружении нет намеренно: нет GOOGLE_SA_*, DRIVE_*,
# *_SPREADSHEET_ID, CALENDAR_ID_*. Функции, которым они нужны, локально падают
# громко. Нужен Google в разработке — заводите отдельные тестовые файлы и
# дописывайте сюда их идентификаторы.

# --- внешний поиск агента (SearXNG) ---
# Контейнер `svoi-searxng-dev` поднимается вместе с остальными (`docker compose up -d`);
# слушает только 127.0.0.1:8080. Включённый флаг без адреса даёт честный отказ
# `web_search_unavailable`, а не выдуманные ссылки.
AGENT_WEB_SEARCH=1
AGENT_WEB_SEARCH_URL=http://127.0.0.1:8080/search
