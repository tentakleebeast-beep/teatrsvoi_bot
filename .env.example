# --- контур ---
ENV=dev                          # dev | prod (guard от записи в боевые файлы)
TZ_OFFSET_HOURS=4                # Самара, UTC+4 (по требованию заказчика)
# Транспорт Telegram — только long polling; переменной MODE нет (решение 28.10.2026)

# --- Telegram ---
# Этот файл (.env) — конфиг боевого контура: его читают сервисы на сервере.
# Локальные запуски и агенты launchd работают на `.env.dev` (dev-бот, локальная БД):
# см. `.env.dev.example` и docs/infrastructure/08 §1a.
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=                   # твой chat_id — станет admin

# --- БД ---
DATABASE_URL=postgresql://svoi:svoi_dev_password@127.0.0.1:5433/svoi
POSTGRES_PASSWORD=svoi_dev_password

# --- сервис ---
TOOL_API_URL=http://127.0.0.1:8000
TOOL_API_TOKEN=dev-token

# --- секреты и лимиты приложения ---
WEBAPP_SECRET=                   # подпись токенов Mini App; если пусто — берётся TOOL_API_TOKEN
WEBAPP_BASE_URL=                 # адрес Mini App для кнопок в боте, вида https://teatr-svoi.online;
                                 # пусто — кнопок нет; http:// не принимается: Telegram Mini App не откроет
INVITE_TTL_DAYS=7                # срок жизни кода регистрации
NOTIFY_MAX_PER_HOUR=20           # суточный/часовой лимит уведомлений человеку

# --- LLM: одно место для провайдера (docs/infrastructure/75 §7.4) --------------
# Меняется провайдер — меняются эти строки, а не код. Роутер свободного текста
# (`POST /tools/route`, бывший WF-01) берёт адрес и ключ отсюда же.
LLM_BASE_URL=https://openrouter.ai/api/v1   # корень API БЕЗ /chat/completions;
                                            # ProxyAPI: https://api.proxyapi.ru/openai/v1
LLM_API_KEY=                     # ключ провайдера; если пусто — берётся OPENROUTER_API_KEY
LLM_MODEL=                       # если пусто — ASSISTANT_MODEL, затем openai/gpt-4o-mini
LLM_TOOLS_MODEL=                 # модель для вызовов инструментов (агент по файлам);
                                 # пусто — берётся LLM_MODEL
LLM_PROVIDER=                    # метка в llm_usage; если пусто — из домена (openrouter/proxyapi/…)
LLM_TIMEOUT_SECONDS=45           # таймаут запроса ассистента
LLM_MAX_TOKENS=700               # предел ответа ассистента
LLM_TEMPERATURE=0.3              # температура ассистента

# --- старые имена LLM: работают как алиасы, можно не заполнять ---------------
OPENROUTER_API_KEY=              # ключ OpenRouter; устаревшее имя для LLM_API_KEY
ASSISTANT_MODEL=                 # модель; устаревшее имя для LLM_MODEL

# --- Google ---
GOOGLE_SA_JSON=secrets/google-sa.json
BUDGET_SPREADSHEET_ID=
SCHEDULE_SPREADSHEET_ID=
DRIVE_ROOT_ID=
CALENDAR_ID=

# --- календари ---------------------------------------------------------------
# ID берём в Google Calendar: Настройки и общий доступ -> выбрать календарь ->
# раздел «Идентификатор календаря» (вида xxxx@group.calendar.google.com)
CALENDAR_ID_READ=
CALENDAR_ID_VENUE=
CALENDAR_ID_DRAFT=

# --- файлы Drive ---
SCHEDULE_XLSX_ID=                # боевой файл занятости (scripts/reconcile.py)
SCHEDULE_TEST_SPREADSHEET_ID=    # тестовый лист занятости (scripts/fill_test_schedule.py)
FINANCE_SOURCE_ID=               # исходная нативная таблица финансов (scripts/copy_finance_sheet.py)
CONTACTS_SPREADSHEET_ID=         # таблица контактов

# --- объектное хранилище файлов (Ш-1, docs/development/80) -------------------
# Garage на этом же VPS: S3 API для кода, presigned-ссылки для Mini App.
# Эти значения генерирует `python scripts/storage_up.py` и дописывает в .env сам —
# вручную заполнять не нужно, здесь они для полноты картины.
GARAGE_RPC_SECRET=               # 32 байта hex: связь узлов и healthcheck
STORAGE_ENDPOINT=http://127.0.0.1:3900
STORAGE_PUBLIC_ENDPOINT=         # адрес хранилища для браузера (https://files.домен);
                                 # пусто — берётся STORAGE_ENDPOINT, с телефона не откроется
STORAGE_REGION=svoi
STORAGE_ACCESS_KEY=              # GK + 12 байт hex
STORAGE_SECRET_KEY=              # 32 байта hex
STORAGE_BUCKET_PRIVATE=svoi-private
STORAGE_BUCKET_SHARED=svoi-shared
STORAGE_COLD_DIR=/opt/svoi/cold  # второй том: файлы, не открывавшиеся 180 дней
ZIP_MAX_BYTES=104857600          # потолок архива папки (100 МБ); больше — «скачивайте по файлам»

# --- мост обращений прод -> dev (scripts/feedback_sync.py) -------------------
# У прода СВОЙ сервисный токен: он генерируется при развёртывании и лежит
# в /opt/svoi/.env на сервере. Локальный TOOL_API_TOKEN прод не принимает (401).
PROD_API_URL=https://svoi-theater-samara.online
PROD_TOOL_API_TOKEN=             # значение из /opt/svoi/.env, только на этой машине
