# Окружение стенда смоука (Э3, docs/development/143 §6, runbook — docs/development/144).
#
#   cp .env.smoke.example .env.smoke
#   chmod 600 .env.smoke
#   nano .env.smoke          # вписать DEV_BOT_TOKEN и путь к дампу
#
# Это отдельный файл, а не `.env.dev`: стенд живёт в своей базе `svoi_smoke` и на своём
# порту 8011, чтобы не пересечься ни с dev (`svoi`, :8000), ни со стендом ревью
# (`svoi_ui`, :8010). `.env.smoke` в git не попадает (правило `.env.*`), шаблон — да.
#
# Секретов в шаблоне нет: токен dev-бота вставляется на машине разработчика.

# --- контур ---
ENV=smoke
TZ_OFFSET_HOURS=4                # Самара, UTC+4

# --- база стенда: только svoi_smoke ---
# scripts/smoke_data.py отказывается работать с любой другой базой (код 2):
# `svoi` и `svoi_ui` — чужие, писать в них нельзя.
DATABASE_URL=postgresql://svoi:***@127.0.0.1:5433/svoi_smoke
# Дамп, из которого поднимается стенд: свежий ежедневный дамп прода.
SMOKE_DUMP=/Users/<пользователь>/svoi-smoke/svoi_ГГГГ-ММ-ДД_ЧЧММ.dump

# --- сервис стенда ---
TOOL_API_URL=http://127.0.0.1:8011
TOOL_API_PORT=8011
# Токен tool-api стенда: им же подписан вход в Mini App (POST /webapp/auth).
TOOL_API_TOKEN=smoke-token
WEBAPP_SECRET=smoke-secret
WEBAPP_BASE_URL=http://127.0.0.1:8011

# --- Telegram: только dev-бот, никаких живых chat_id ---
DEV_BOT_TOKEN=
ADMIN_CHAT_ID=

# --- Google: на стенде боевых файлов нет ---
# Пусто — функции, которым нужен Google, честно отказывают; шаги сценариев,
# которым нужен Google, помечаются «не проверено» с причиной «нужен Google Sheets/Calendar».
GOOGLE_SA_EMAIL=
LLM_BASE_URL=
LLM_API_KEY=

# --- хранилище стенда (Garage): только локальный контейнер ---
# Нужно для сценария СМ-7 (файлы). Ключи выдаёт `docker exec svoi-garage-dev /garage key …`.
STORAGE_ENDPOINT=http://127.0.0.1:3900
STORAGE_REGION=svoi
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_PRIVATE=svoi-private

# --- прогон сценариев ---
# Гейт: без SVOI_SMOKE_TESTS=1 тесты tests/smoke показываются skipped (К8).
SVOI_SMOKE_TESTS=1
# Маркер прогона: SMOKE-<дата>-<номер прогона в этот день>.
SVOI_SMOKE_MARKER=SMOKE-ГГГГММДД-01
# Куда журнал сценариев пишет шаги для scripts/smoke_report.py.
SVOI_SMOKE_SCENARIOS=smoke-scenarios.json

# --- прод-режим (слой В): до ответа на V-042 не заполняется и не используется ---
PROD_TOOL_API_URL=
PROD_DATABASE_URL=