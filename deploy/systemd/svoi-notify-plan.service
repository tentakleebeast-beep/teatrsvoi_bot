[Unit]
Description=SVOI planning of reminders (dues, availability)
Documentation=file:///opt/svoi/docs/infrastructure/35-deploy-runbook.md
After=network.target svoi-tool-api.service postgresql.service

[Service]
Type=oneshot
User=svoi
Group=svoi
WorkingDirectory=/opt/svoi
EnvironmentFile=/opt/svoi/.env
ExecStart=/opt/svoi/.venv/bin/python scripts/plan_reminders.py --apply
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
