[Unit]
Description=SVOI sending of queued notifications
Documentation=file:///opt/svoi/docs/infrastructure/35-deploy-runbook.md
After=network.target svoi-tool-api.service

[Service]
Type=oneshot
User=svoi
Group=svoi
WorkingDirectory=/opt/svoi
EnvironmentFile=/opt/svoi/.env
ExecStart=/opt/svoi/.venv/bin/python scripts/send_notifications.py --apply --limit 50
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
