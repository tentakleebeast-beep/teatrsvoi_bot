[Unit]
Description=SVOI conflict watcher (409 Conflict поллера в логе гейтвея)
Documentation=file:///opt/svoi/docs/infrastructure/35-deploy-runbook.md
After=network.target svoi-gateway.service

[Service]
Type=oneshot
User=svoi
Group=svoi
WorkingDirectory=/opt/svoi
EnvironmentFile=/opt/svoi/.env
ExecStart=/opt/svoi/.venv/bin/python scripts/conflict_watch.py --source journal --unit svoi-gateway --apply
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
