<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.svoi.tool-api</string>

	<key>ProgramArguments</key>
	<array>
		<string>@PYTHON@</string>
		<string>@PROJECT@/scripts/run_service.py</string>
		<string>tool-api</string>
		<string>--env</string>
		<string>@ENV@</string>
	</array>

	<key>WorkingDirectory</key>
	<string>@PROJECT@</string>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONPATH</key>
		<string></string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<!-- Среда явно: агент на маке всегда dev (.env.dev, dev-бот), прод
		     живёт на сервере под systemd (docs/infrastructure/08 §1a). -->
		<key>SVOI_ENV</key>
		<string>@ENV@</string>
	</dict>

	<key>StandardOutPath</key>
	<string>@LOG_DIR@/tool-api.log</string>
	<key>StandardErrorPath</key>
	<string>@LOG_DIR@/tool-api.err.log</string>
</dict>
</plist>
