# Настройки переезда: один файл на все скрипты deploy/ (docs/infrastructure/75).
#
#   cp deploy/svoi.env.example deploy/svoi.env
#   nano deploy/svoi.env        # заполнить 6 значений из блока «обязательно»
#   chmod 600 deploy/svoi.env
#
# deploy/svoi.env в git не попадает (.gitignore). Секретов здесь нет —
# токены и ключи живут только в /opt/svoi/.env на сервере.

# --- обязательно -------------------------------------------------------------
# Домен приложения: по нему открывается Mini App и /api. Зона .online, см. §3.4.
SVOI_DOMAIN="teatr-svoi.online"
# Почта для Let's Encrypt: на неё придут письма об истечении сертификата.
SVOI_ACME_EMAIL="admin@teatr-svoi.online"
# Откуда брать код. Для приватного репозитория — deploy key на сервере.
SVOI_REPO="git@github.com:OWNER/teatrsvoi-bot.git"
# Ветка или тег первого выката.
SVOI_REF="main"

# --- сервер ------------------------------------------------------------------
# Куда ставим. Менять можно, но /opt/svoi — путь по умолчанию во всех документах.
SVOI_ROOT="/opt/svoi"
SVOI_USER="svoi"
SVOI_TZ="Europe/Samara"
# Swap в гигабайтах. 0 — не создавать. 2 ГБ хватает, чтобы короткий пик
# (pip install, сборка зависимостей) не убил процесс на сервере с 2 ГБ RAM (docs/75 §2.6).
SVOI_SWAP_GB="2"

# Порты наружу не смотрят: их слушает только Caddy на 127.0.0.1.
SVOI_API_PORT="8000"
SVOI_PG_PORT="5432"

# --- база --------------------------------------------------------------------
SVOI_PG_CONTAINER="svoi-postgres"
SVOI_DB_NAME="svoi"
SVOI_DB_USER="svoi"

# Дамп локальной базы для первого переноса (docs/infrastructure/75 §7).
# Оставьте пустым, если база создаётся с нуля (схему накатывает Alembic).
SVOI_DUMP=

# Каталог бэкапов; его же проверяет scripts/watchdog.sh.
# Значения в кавычках: путь может содержать пробел, а shell читает этот файл как есть.
SVOI_BACKUP_DIR="/opt/svoi/backups"
# Ключ деплоя — от рабочего пользователя, не root: git запускается через runuser.
# По умолчанию /home/<SVOI_USER>/.ssh/id_ed25519.
SVOI_GIT_KEY=""

# --- доступ по ssh (нужен только deploy/poller-switch.sh с локальной машины) --
SVOI_SERVER="203.0.113.10"
# Кем подключаться с ноутбука при переключении поллера. Системные службы включаются
# только от root, поэтому здесь обычно root; svoi хватает для чтения.
SVOI_SSH_USER="root"
SVOI_SSH_KEY="~/.ssh/svoi_prod"
SVOI_SSH_PORT="22"
